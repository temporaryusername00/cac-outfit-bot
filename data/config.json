{
  "window_title": "Roblox",
  "accounts": [],
  "ram": {
    "port": 7963,
    "password": "",
    "place_id": 7041939546,
    "seconds_between_launches": 8.0,
    "window_timeout": 90.0,
    "game_load_seconds": 30.0
  },
  "launch_window_size": [
    816,
    638
  ],
  "max_publish_per_run": 20,
  "seconds_between_outfits": 5.0,
  "max_failures_per_window": 3,
  "delays": {
    "after_focus": 0.2,
    "after_step": 0.25,
    "equip_load": 0.7,
    "expect_timeout": 3.0,
    "key_interval": 0.03,
    "panel_load": 0.6,
    "publish_load": 1.0
  },
  "point_hints": {
    "catalog_accessories": "inside the ACCESSORIES tile, near its bottom-right (must be empty space once the item list is open)",
    "catalog_button": "big 'Catalog' button at the top of the main screen",
    "close_catalog": "X at the top-right of the catalog list",
    "close_item": "X on an item's page",
    "close_outfits": "X at the top-right of the Outfits panel",
    "discover_tab": "'Discover' tab at the top of the Outfits panel (only that tab has the Publish button)",
    "item_link_box": "'Enter Item Link..' box at the bottom of the catalog list",
    "news_close": "X on CAC's 'New Update!' popup (new accounts see it once)",
    "outfit_name_box": "'Enter Outfit Name' box in the Publish popup",
    "outfits_button": "big 'Outfits' button at the top of the main screen",
    "publish_button": "green 'Publish' button at the bottom-left of the Outfits panel",
    "publish_cancel": "'Cancel' button in the Publish popup",
    "publish_confirm": "white 'Publish' button in the Publish popup",
    "removal_close": "X on the Item Removal popup",
    "reset_accessories": "'Accessories' checkbox in the Item Removal popup",
    "reset_avatar": "trash-can button under the avatar preview (catalog open)",
    "reset_classic": "'Classic Clothing' checkbox in the Item Removal popup",
    "reset_hair": "'Hair' checkbox in the Item Removal popup",
    "reset_layered": "'Layered Clothing' checkbox in the Item Removal popup",
    "reset_remove": "red 'Remove' button in the Item Removal popup",
    "try_on": "'Try On' button on an item's page"
  },
  "flow": {
    "start": [
      {
        "click": "catalog_button",
        "expect_not": "main"
      },
      {
        "wait": "panel_load"
      },
      {
        "click": "catalog_accessories",
        "expect": "catalog_list"
      },
      {
        "click": "reset_avatar",
        "expect": "removal_popup"
      },
      {
        "click": "reset_accessories"
      },
      {
        "click": "reset_hair"
      },
      {
        "click": "reset_classic"
      },
      {
        "click": "reset_layered"
      },
      {
        "click": "reset_remove",
        "expect": "catalog_list",
        "retries": 0
      },
      {
        "wait": "equip_load"
      }
    ],
    "per_item": [
      {
        "click": "item_link_box"
      },
      {
        "key": "ctrl+a"
      },
      {
        "key": "backspace"
      },
      {
        "type": "{item_id}"
      },
      {
        "key": "enter"
      },
      {
        "timeout": 6.0,
        "wait_for": "item_page"
      },
      {
        "wait": 0.3
      },
      {
        "click": "try_on"
      },
      {
        "wait": "equip_load"
      },
      {
        "click": "close_item",
        "expect": "catalog_list",
        "retries": 0
      }
    ],
    "finish": [
      {
        "click": "close_catalog",
        "expect": "main"
      },
      {
        "click": "outfits_button",
        "expect_not": "main"
      },
      {
        "wait": "panel_load"
      },
      {
        "click": "discover_tab",
        "expect": "outfits_panel"
      },
      {
        "click": "publish_button",
        "expect": "publish_dialog",
        "on_fail_note": "CAC lets new accounts publish only after some minutes of play time (or Roblox's publish cooldown is on)",
        "on_fail_wait": 120
      },
      {
        "click": "outfit_name_box"
      },
      {
        "key": "ctrl+a"
      },
      {
        "type": "{name}"
      },
      {
        "wait": 0.3
      },
      {
        "click": "publish_confirm",
        "expect": "published_page",
        "retries": 0,
        "timeout": 10.0,
        "live_only": true,
        "publishes": true
      },
      {
        "click": "close_published",
        "expect": "outfits_panel",
        "live_only": true
      },
      {
        "click": "publish_cancel",
        "expect": "outfits_panel",
        "retries": 0,
        "test_only": true
      },
      {
        "wait": "publish_load"
      },
      {
        "click": "close_outfits",
        "expect": "main"
      }
    ]
  },
  "recovery": {
    "order": [
      "news_popup",
      "publish_dialog",
      "removal_popup",
      "published_page",
      "item_page",
      "item_loading",
      "outfits_panel",
